@model IEnumerable<Category>
@{
    ViewBag.Title = "Product List";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Our Products</h1>
        <p class="text-muted">Browse our latest collection by category</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No categories available at the moment.</div>
    }

    @foreach (var category in Model)
    {
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-4">
                <h3 class="fw-semibold mb-0">
                    <i class="fa-solid fa-tags text-primary me-2"></i>@category.Name
                </h3>
                <span class="badge bg-secondary rounded-pill">@category.Products.Count() Items</span>
            </div>

            @if (!category.Products.Any())
            {
                <p class="text-muted fst-italic">No products in this category yet.</p>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var product in category.Products)
                    {
                        var imagePath = product.ProductImages != null && product.ProductImages.Any()
                            ? product.ProductImages.First().Path
                            : "/images/no-image.png";

                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="card h-100 shadow-sm border-0 product-card">
                                <div class="ratio ratio-1x1 bg-light">
                                    <img src="@imagePath"
                                         class="card-img-top"
                                         style="object-fit:cover;"
                                         alt="@product.Name" />
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title fw-semibold text-truncate mb-2" title="@product.Name">
                                        @product.Name
                                    </h6>
                                    <span class="badge bg-success-subtle text-success fs-6 mb-3 align-self-start">
                                        @product.Price.ToString("C")
                                    </span>
                                    <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id"
                                       class="btn btn-outline-primary btn-sm mt-auto">
                                        <i class="fa-solid fa-eye me-1"></i>View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1) !important;
        }
</style>