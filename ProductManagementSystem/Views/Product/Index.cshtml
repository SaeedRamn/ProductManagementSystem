@model List<Product>
@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-5">
    <h1 class="fw-bold">Product List</h1>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
            + Add New Product
        </a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var imagePath = item.ProductImages != null && item.ProductImages.Any()
                    ? item.ProductImages.First().Path
                    : "/images/no-image.png";

                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <img src="@imagePath"
                             alt="Product Image"
                             style="width:60px; height:60px; object-fit:cover; border-radius:6px;" />
                    </td>
                    <td>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                            Details
                        </a>
                        <a asp-controller="Product" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                            Edit
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <h5 class="text-muted">Total Products: @ViewBag.Count</h5>
    </div>
</div>